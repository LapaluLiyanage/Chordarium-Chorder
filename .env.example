# Copy to .env (never commit .env) and fill in. Use only letters and digits in the password (it goes into a URL).
POSTGRES_PASSWORD=change-me-use-only-letters-and-digits

# Optional
# CHORDARIUM_PDF_OWNER=Your Name      # printed in the PDF footer: "(c) 2026 Your Name. All rights reserved."
# WEB_PORT=8080
# WEB_BIND=127.0.0.1                  # 0.0.0.0 to reach it from other devices on your network
